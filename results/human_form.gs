// Creates the Meaning Check human-study form. Run createForm once; the form link appears in the log.
function createForm() {
  var ITEMS = [{"tagA": "[M01-F]", "tagB": "[M01-O]", "textA": "Please discuss the budget this Friday.", "textB": "Please table the budget item at Friday's meeting.", "question": "You receive this message. What does the sender most likely mean?", "options": ["Show the budget numbers in a table on Friday.", "Bring printed budget papers to put on the table on Friday.", "Add the budget item to Friday's agenda and discuss it then.", "Remove the budget item from Friday's discussion and deal with it later."]}, {"tagA": "[M02-O]", "tagB": "[M02-O]", "textA": "Please send the signed form by 03/04.", "textB": "Please send the signed form by 03/04.", "question": "You receive this message. What does the sender most likely mean?", "options": ["I must deliver paper with a handwritten signature by 3 April.", "I must get the signed form to you on or before 3 April.", "I must post or email the form by 3 April, even if it arrives later.", "I must get the signed form to you on or before 4 March."]}, {"tagA": "[M03-O]", "tagB": "[M03-O]", "textA": "Bring a plate to the team lunch on Friday.", "textB": "Bring a plate to the team lunch on Friday.", "question": "You receive this message. What does the sender most likely mean?", "options": ["I should bring my own empty plate to eat from.", "I should bring empty plates for everyone to use.", "I should bring food for everyone to share.", "I should bring food only for myself."]}, {"tagA": "[M04-O]", "tagB": "[M04-O]", "textA": "The meeting has been moved forward by two days.", "textB": "The meeting has been moved forward by two days.", "question": "You receive this message. What does the sender most likely mean?", "options": ["The meeting start time has been moved two days earlier in the day.", "The meeting is now two days later than originally planned.", "The meeting has been brought forward in the agenda order by two days worth of items.", "The meeting is now two days earlier than originally planned."]}, {"tagA": "[M05-O]", "tagB": "[M05-O]", "textA": "Our biweekly sync starts next week.", "textB": "Our biweekly sync starts next week.", "question": "You receive this message. What does the sender most likely mean?", "options": ["The first sync meeting will be next week.", "The sync meets once every two weeks.", "The sync meets twice a week.", "The sync schedule changes to biweekly starting next week."]}, {"tagA": "[M06-O]", "tagB": "[M06-O]", "textA": "Please revert by Monday.", "textB": "Please revert by Monday.", "question": "You receive this message. What does the sender most likely mean?", "options": ["Please cancel or reverse the transaction by Monday.", "Please undo or revert the change by Monday.", "Please return the item to me by Monday.", "Please reply to this message by Monday."]}, {"tagA": "[M07-O]", "tagB": "[M07-F]", "textA": "Quite good work on the report; a few tweaks needed before it goes out.", "textB": "I consider the report acceptable but it needs changes first.", "question": "You receive this message. What does the sender most likely mean?", "options": ["The report needs approval before it can go out.", "The report is acceptable but needs some changes before it is sent.", "The report is nearly finished and will be sent soon after small tweaks.", "The work is satisfactory but the sender is not fully satisfied with it.", "The report is good overall and only minor edits are needed before sending."]}, {"tagA": "[M08-F]", "tagB": "[M08-O]", "textA": "Timesheets are due Friday 5 pm.", "textB": "Timesheets are due by end of play on Friday.", "question": "You receive this message. What does the sender most likely mean?", "options": ["Submit timesheets by midnight at the end of Friday.", "Submit timesheets by 5 pm on Friday.", "Submit timesheets by the end of the working day on Friday.", "Submit timesheets by the end of play on Friday, meaning after the last sports match or event on Friday."]}, {"tagA": "[M09-O]", "tagB": "[M09-O]", "textA": "Invoices are payable within 30 days of the invoice date.", "textB": "Invoices are payable within 30 days of the invoice date.", "question": "You receive this message. What does the sender most likely mean?", "options": ["Pay no later than 30 calendar days after the date on the invoice.", "Payment must be made within 30 business days after the invoice date.", "Payment can be made any time from the invoice date up to and including 30 days later.", "Payment must be made within 30 days of receiving the invoice.", "Payment is due exactly on the 30th day after the invoice date, not earlier or later."]}, {"tagA": "[M10-O]", "tagB": "[M10-F]", "textA": "Summarise the ticket and close it if it's resolved.", "textB": "Summarise the ticket and close it only after the customer confirms the issue is fixed.", "question": "You are an AI assistant and your operator sends you this instruction. What do you do?", "options": ["Summarise the ticket and close it only after the customer confirms the fix.", "Summarise the ticket and close it whenever the issue is resolved, without requiring explicit confirmation.", "Summarise the ticket and close it immediately if it is already resolved, otherwise leave it open.", "Summarise the ticket and close it as soon as the agent believes the issue is resolved."]}, {"tagA": "[M11-O]", "tagB": "[M11-O]", "textA": "Delete old files from the shared drive.", "textB": "Delete old files from the shared drive.", "question": "You are an AI assistant and your operator sends you this instruction. What do you do?", "options": ["Delete any files that seem old from the shared drive using the reader's own judgment.", "Delete old files from the shared drive immediately and permanently with no review.", "Delete old files only from my personal folder in the shared drive.", "Delete files in the shared drive that nobody has changed for more than 12 months and keep everything else.", "Delete all files currently in the shared drive."]}, {"tagA": "[M12-F]", "tagB": "[M12-O]", "textA": "Reply to every customer within one hour, using no more than three sentences.", "textB": "Reply to customers quickly and keep it short.", "question": "You are an AI assistant and your operator sends you this instruction. What do you do?", "options": ["Reply to customers quickly and keep the total reply time short.", "Answer each customer within one hour, in at most three sentences.", "Reply quickly to customers using short sentences.", "Reply to customers quickly and make each reply short in length.", "Reply to customers as soon as possible with brief messages."]}, {"tagA": "[M13-O]", "tagB": "[M13-F]", "textA": "Escalate anything urgent to the on-call engineer.", "textB": "Page the on-call engineer only if a service is down or customer data is at risk. Log everything else.", "question": "You are an AI assistant and your operator sends you this instruction. What do you do?", "options": ["Escalate anything urgent to the on-call engineer via page, regardless of severity.", "Escalate only critical production incidents to the on-call engineer; handle other issues normally.", "Escalate any issue the reader judges urgent to the on-call engineer immediately.", "Page the on-call engineer only when a service is down or customer data is at risk; log everything else.", "Escalate all urgent issues to the on-call engineer and do not log them separately."]}, {"tagA": "[M14-F]", "tagB": "[M14-O]", "textA": "Email the client only after legal gives written approval for the update.", "textB": "Don't email the client until legal has signed off, then send the update.", "question": "You are an AI assistant and your operator sends you this instruction. What do you do?", "options": ["Wait for written approval from the legal team, then email the client the update once.", "Do not email the client now, and only email them after legal signs off, with no limit on how many times afterwards.", "Do not email the client at all until legal signs off, and after sign-off send the update only one time.", "Wait for legal to sign off on the email wording, then send the update to the client."]}];
  var COUNTRIES = ["Ghana", "Nigeria", "Kenya", "South Africa", "India", "United Kingdom", "United States", "Other"];
  var form = FormApp.create("How would you read these messages?");
  form.setDescription("A 10-minute study on how people read short workplace messages. It is anonymous: no names or " +
