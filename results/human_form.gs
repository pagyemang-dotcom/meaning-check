  var pageB = form.addPageBreakItem().setTitle("Messages");
  ITEMS.forEach(function (it) {
    form.addMultipleChoiceItem().setTitle(it.tagB + " " + it.question).setHelpText(it.textB)
      .setChoiceValues(it.options).setRequired(true);
